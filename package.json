{
  "name": "visionhub",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @visionhub/api --filter @visionhub/web dev",
    "build": "pnpm --filter @visionhub/api build && pnpm --filter @visionhub/web build",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "db:generate": "pnpm --filter @visionhub/api db:generate",
    "db:migrate": "pnpm --filter @visionhub/api db:migrate:deploy",
    "db:seed": "pnpm --filter @visionhub/api db:seed",
    "db:setup": "pnpm --filter @visionhub/api db:setup",
    "test": "pnpm --filter @visionhub/api build && pnpm --filter @visionhub/api test"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
