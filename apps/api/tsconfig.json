{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": "./src",
    "types": [
      "node"
    ],
    "paths": {
      "@visionhub/contracts": [
        "../../contracts/catalog.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
