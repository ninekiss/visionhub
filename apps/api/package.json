{
  "name": "@visionhub/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "prisma generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.seed.json",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.seed.json",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "tsx prisma/bootstrap-schema.ts && prisma migrate deploy",
    "db:seed": "prisma generate && prisma db seed",
    "db:setup": "tsx prisma/bootstrap-schema.ts && prisma migrate deploy && prisma generate && prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/core": "latest",
    "@nestjs/platform-express": "latest",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "pg": "^8.16.3",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "yaml": "latest"
  },
  "devDependencies": {
    "@types/express": "latest",
    "@types/node": "latest",
    "prisma": "7.10.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
