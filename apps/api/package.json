{
  "name": "@visionhub/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "prisma generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.seed.json",
    "typecheck": "prisma generate && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.seed.json",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "tsx prisma/bootstrap-schema.ts && prisma migrate deploy",
    "db:seed": "prisma generate && prisma db seed",
    "db:setup": "tsx prisma/bootstrap-schema.ts && prisma migrate deploy && prisma generate && prisma db seed",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@visionhub/config": "workspace:*",
    "@visionhub/contracts": "workspace:*",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
