{
  "manifest_version": 3,
  "name": "VisionHub Source Progress",
  "version": "0.4.0",
  "description": "Save playback progress in VisionHub source iframes, retry resume seeks while source players initialize, and resume focus-loss pauses.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "declarativeNetRequest"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "VisionHub Source Progress",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
