{
  "manifest_version": 3,
  "name": "VisionHub Source Progress",
  "version": "0.1.0",
  "description": "Save and restore playback position for native HTML5 videos inside VisionHub source iframes.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "webNavigation"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "VisionHub Source Progress",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
