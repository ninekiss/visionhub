# Existing Docker network containing your PostgreSQL container.
EXISTING_DB_NETWORK=existing-database-network

# Host ports: local dev API listens at API_DEV_PORT; Compose publishes API_PORT.
WEB_PORT=8080
API_PORT=3000
API_DEV_PORT=3001
NODE_ENV=development

# Local development reads this config; the dev launcher applies it explicitly.
APP_CONFIG_PATH_DEV=./configs/app.development.yaml

# Admin login. Fill these in your local .env; blank values disable admin access.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# false for the included plain-HTTP Compose setup; set true behind HTTPS.
ADMIN_COOKIE_SECURE=false

# Host-side proxy target for Vite. Usually derived from API_DEV_PORT.
# API_DEV_PROXY_TARGET=http://127.0.0.1:3001

# Used by "pnpm db:setup" from your host machine.
# Change localhost/port to the reachable address of your existing PostgreSQL server.
DATABASE_URL=postgresql://app:change-me@localhost:5432/visionhub?schema=visionhub

# Used inside Compose containers on the external database network.
# Replace "postgres" with the hostname/alias reachable from that Docker network.
DATABASE_URL_DOCKER=postgresql://app:change-me@postgres:5432/visionhub?schema=visionhub
