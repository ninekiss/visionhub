# Existing Docker network containing the PostgreSQL container.
EXISTING_DB_NETWORK=existing-database-network
WEB_PORT=8080
API_PORT=3000
APP_CONFIG_PATH=./configs/app.yaml
# Used when the API begins querying PostgreSQL. Do not commit real credentials.
DATABASE_URL=postgresql://app:change-me@postgres:5432/visionhub?schema=public
NODE_ENV=production