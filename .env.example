# Host-side API / Prisma CLI connection. Use any PostgreSQL hostname or IP reachable from this machine.
# If using the opt-in Compose PostgreSQL service, the service publishes localhost:5433.
DATABASE_URL=postgresql://app:replace-me@127.0.0.1:5433/visionhub?schema=visionhub

# Optional API-container override when its database address differs from the host-side URL.
# The configured address must be reachable from inside the container.
# For the opt-in Compose database overlay, uncomment this example and keep credentials aligned with POSTGRES_*.
# DATABASE_URL_DOCKER=postgresql://app:replace-me@postgres:5432/visionhub?schema=visionhub

# Base image for the opt-in managed PostgreSQL service; keep major version 18 for physical incremental backups.
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_DB=visionhub
POSTGRES_USER=app
POSTGRES_PASSWORD=replace-me
POSTGRES_PORT=5433

# Needed only when using infra/compose.existing-db-network.yaml.
EXISTING_DB_NETWORK=existing-database-network

# Host ports: Web is public by default. API_PORT is used only with infra/compose.api-published.yaml.
WEB_PORT=8080
API_PORT=3000
API_DEV_PORT=3001
NODE_ENV=development

# Local development uses shared defaults plus this environment-specific YAML.
APP_CONFIG_PATH_DEV=./configs/app.development.yaml
# Optional config overrides; uncomment only when needed.
# APP_CONFIG_DIR=./configs
# APP_CONFIG_COMMON_PATH=./configs/app.defaults.yaml
# APP_SECRETS_PATH=./configs/secrets.yaml
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DESKTOP_API_BASE_URL=http://127.0.0.1:3000/api/v1

# Admin login. Fill these in your local .env; blank values disable admin access.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
# false for the included plain-HTTP Compose setup; set true behind HTTPS.
ADMIN_COOKIE_SECURE=false

# Retention used by db-tools; backups are written to the repository-root backups/ folder.
LOGICAL_RETENTION_DAYS=30
PHYSICAL_KEEP_FULL=4

# Persistent host directory mounted into the database-tools/backup containers.
# On a cloud VM, prefer an absolute path on a persistent disk, e.g. /srv/visionhub/backups.
BACKUP_HOST_DIR=../backups

# Optional containerized scheduler. The base Compose file defaults to direct mode;
# compose.database.yaml and compose.existing-db-network.yaml select their own modes.
BACKUP_DATABASE_MODE=direct
BACKUP_SCHEDULE_TIME=02:30
BACKUP_TIMEZONE=UTC
BACKUP_RETRY_MINUTES=15

# Optional generic JSON webhook notifications for backup failures and recovery.
# Use an HTTPS URL for internet-reachable endpoints; do not commit real values.
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_WEBHOOK_TOKEN=

# Optional off-site copy to S3-compatible object storage through rclone.
# Example destination: cloud:your-bucket/visionhub (leave blank to disable upload).
BACKUP_REMOTE=
# Asymmetric encryption recipient(s) for off-site backups (public age keys only).
# Generate a key pair offline with "age-keygen -o backup-identity.txt";
# set this to the public age1... recipient shown in that file. Never upload the identity.
BACKUP_AGE_RECIPIENTS=
RCLONE_CONFIG_CLOUD_TYPE=s3
RCLONE_CONFIG_CLOUD_PROVIDER=Other
RCLONE_CONFIG_CLOUD_ACCESS_KEY_ID=
RCLONE_CONFIG_CLOUD_SECRET_ACCESS_KEY=
RCLONE_CONFIG_CLOUD_SESSION_TOKEN=
RCLONE_CONFIG_CLOUD_ENDPOINT=
RCLONE_CONFIG_CLOUD_REGION=auto
RCLONE_CONFIG_CLOUD_ENV_AUTH=false

# Host-side proxy target for Vite. Usually derived from API_DEV_PORT.
# API_DEV_PROXY_TARGET=http://127.0.0.1:3001
